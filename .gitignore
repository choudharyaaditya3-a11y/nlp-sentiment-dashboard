# Data - the raw/processed dataset is regenerated by the fetch/pipeline
# scripts, not hand-edited, so it doesn't need to live in git history.
# Comment these out if you'd rather commit a data snapshot for reviewers.
data/raw/*.csv
data/processed/*
!data/processed/.gitkeep

# Hugging Face model cache, if downloaded locally instead of to the
# default cache dir
model_cache/
